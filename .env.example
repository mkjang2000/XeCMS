# XeCMS M1 local development defaults.
# Copy this file to .env and replace every secret before using a shared or
# production-like environment.

NODE_ENV=development
XECMS_HOST=127.0.0.1
XECMS_PORT=3100
XECMS_ADMIN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional cross-origin frontends that may use Content Realm cookies.
XECMS_CONTENT_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
DATABASE_URL=postgresql://xecms:xecms@127.0.0.1:54320/xecms

XECMS_POSTGRES_DB=xecms
XECMS_POSTGRES_USER=xecms
XECMS_POSTGRES_PASSWORD=xecms
XECMS_POSTGRES_PORT=54320

# Development convenience account. The server must refuse this option when
# NODE_ENV is not exactly "development".
XECMS_DEV_SEED=true
XECMS_DEV_ADMIN_USERNAME=admin
XECMS_DEV_ADMIN_PASSWORD=admin

# Replace with at least 32 random bytes outside local development.
XECMS_SESSION_SECRET=local-development-only-change-me

# M2 local media storage. File bytes stay outside PostgreSQL; metadata and
# document references remain transactional in the database.
XECMS_MEDIA_STORAGE_ROOT=.xecms/media
XECMS_MEDIA_MAX_UPLOAD_BYTES=26214400
XECMS_MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf

# M4-B durable event Worker
XECMS_WORKER_ENABLED=true
XECMS_WORKER_POLL_MS=1000
XECMS_WORKER_BATCH_SIZE=20
XECMS_WORKER_LEASE_MS=30000
XECMS_WORKER_MAX_ATTEMPTS=8

# Playwright uses an isolated PostgreSQL service and these URLs.
XECMS_E2E_POSTGRES_PORT=55432
XECMS_E2E_DATABASE_URL=postgresql://xecms:xecms@127.0.0.1:55432/xecms_e2e
XECMS_SERVER_URL=http://127.0.0.1:3100
XECMS_E2E_ADMIN_URL=http://127.0.0.1:3100
