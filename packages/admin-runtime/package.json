{
  "name": "@xecms/admin-runtime",
  "version": "0.5.0",
  "description": "Runtime components for composed XeCMS admin applications.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/mkjang2000/XeCMS.git", "directory": "packages/admin-runtime" },
  "homepage": "https://github.com/mkjang2000/XeCMS#readme",
  "bugs": { "url": "https://github.com/mkjang2000/XeCMS/issues" },
  "engines": { "node": ">=22.22.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/composed-geometry.d.ts",
      "default": "./dist/composed-geometry.js"
    }
  },
  "files": [
    "dist",
    "src/*.css",
    "!dist/**/*.test.*",
    "!dist/**/*.integration.test.*",
    "!dist/.tsbuildinfo"
  ],
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "dependencies": {
    "@xecms/admin-apps": "workspace:*",
    "@xecms/contracts": "workspace:*",
    "@xecms/ui": "workspace:*",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
