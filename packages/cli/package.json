{
  "name": "@xecms/cli",
  "version": "0.5.0",
  "description": "Command-line tools for creating, running, migrating and operating XeCMS projects.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/mkjang2000/XeCMS.git", "directory": "packages/cli" },
  "homepage": "https://github.com/mkjang2000/XeCMS#readme",
  "bugs": { "url": "https://github.com/mkjang2000/XeCMS/issues" },
  "engines": { "node": ">=22.22.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "bin": {
    "xecms": "./dist/bin.js",
    "create-xecms": "./dist/bin-create.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.integration.test.*",
    "!dist/.tsbuildinfo"
  ],
  "dependencies": {
    "@xecms/database": "workspace:*",
    "@xecms/plugin-sdk": "workspace:*",
    "@xecms/schema": "workspace:*",
    "@xecms/server": "workspace:*"
  }
}
