{
  "name": "@xecms/ui",
  "version": "0.5.0",
  "description": "Accessible UI primitives and theme for XeCMS.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/mkjang2000/XeCMS.git", "directory": "packages/ui" },
  "homepage": "https://github.com/mkjang2000/XeCMS#readme",
  "bugs": { "url": "https://github.com/mkjang2000/XeCMS/issues" },
  "engines": { "node": ">=22.22.0" },
