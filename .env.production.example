# Copy to .env.production and replace every example value before deployment.
# Run with: XECMS_ENV_FILE=.env.production pnpm start

NODE_ENV=production
XECMS_HOST=127.0.0.1
XECMS_PORT=3100
DATABASE_URL=postgresql://xecms:replace-me@127.0.0.1:5432/xecms
XECMS_DB_SCHEMA=xecms

# Public HTTPS origins only. Do not include a path or trailing application URL.
XECMS_ADMIN_ORIGINS=https://cms.example.com
XECMS_CONTENT_ORIGINS=https://www.example.com

# Generate at least 32 random bytes, for example: openssl rand -base64 48
XECMS_SESSION_SECRET=replace-me-before-start

# Persist and back up this directory together with PostgreSQL.
XECMS_MEDIA_STORAGE_ROOT=/var/lib/xecms/media
XECMS_MEDIA_MAX_UPLOAD_BYTES=26214400
XECMS_MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf

XECMS_SCHEMA_MODE=locked
XECMS_WORKER_ENABLED=true
XECMS_WORKER_POLL_MS=1000
XECMS_WORKER_BATCH_SIZE=20
XECMS_WORKER_LEASE_MS=30000
XECMS_WORKER_MAX_ATTEMPTS=8

# Configure commands and container/host URLs for the deployment environment.
XECMS_PG_DUMP_COMMAND_JSON=["pg_dump"]
XECMS_PG_RESTORE_COMMAND_JSON=["pg_restore"]
XECMS_BACKUP_DATABASE_URL=postgresql://xecms:replace-me@127.0.0.1:5432/xecms
XECMS_RESTORE_DATABASE_URL=postgresql://xecms:replace-me@127.0.0.1:5432/xecms
