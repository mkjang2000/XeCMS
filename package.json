{
  "name": "xecms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "build:admin": "pnpm --filter @xecms/admin-app build",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs && node scripts/check-m1-boundaries.mjs",
    "check:docs": "node scripts/check-document-links.mjs",
    "check:dev-sources": "pnpm --filter @xecms/server exec tsx --tsconfig ../../tsconfig.dev.json ../../scripts/check-dev-source-resolution.ts && pnpm build:admin",
    "check": "pnpm check:boundaries && pnpm check:docs && pnpm typecheck && pnpm test",
    "prototype:run": "node examples/domain-prototype/dist/index.js",
    "prototype": "pnpm build && pnpm prototype:run",
    "check:prototype": "node scripts/check-domain-prototype.mjs",
    "verify:m0:after-clean": "pnpm check && pnpm build && pnpm check:prototype",
    "verify:m0": "pnpm clean && pnpm verify:m0:after-clean",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "node scripts/run-m1-migrate.mjs",
    "dev:m1": "node scripts/run-m1-dev.mjs",
    "test:e2e": "node scripts/run-m1-e2e.mjs",
    "test:e2e:m2": "node scripts/run-m2-e2e.mjs",
    "test:e2e:m3": "node scripts/run-m3-e2e.mjs",
    "test:e2e:m4a": "node scripts/run-m4a-e2e.mjs",
    "test:e2e:m4b": "node scripts/run-m4b-e2e.mjs",
    "test:e2e:m4c4": "node scripts/run-m4c4-e2e.mjs",
    "verify:m1": "pnpm clean && pnpm check:dev-sources && pnpm verify:m0:after-clean && pnpm build:admin && pnpm test:e2e",
    "verify:m2a": "pnpm verify:m1",
    "verify:m2": "pnpm check && pnpm test:e2e:m2",
    "verify:m3": "pnpm check && pnpm test:e2e:m3",
    "verify:m4a": "pnpm check && pnpm test:e2e:m4a",
    "verify:m4b": "pnpm check && pnpm test:e2e:m4b",
    "verify:m4c4": "pnpm check && pnpm test:e2e:m4c4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
