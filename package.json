{
  "name": "xecms",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:admin && pnpm check:boundaries -- --built",
    "build:packages": "tsc -b tsconfig.json",
    "build:admin": "pnpm --filter @xecms/admin-app build",
    "clean": "node scripts/clean-build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node packages/cli/dist/bin.js start",
    "migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:database": "node scripts/run-postgres-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "benchmark:database": "node scripts/run-postgres-tests.mjs --benchmark",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:docs": "node scripts/check-document-links.mjs",
    "check:source-resolution": "pnpm --filter @xecms/server exec tsx --tsconfig ../../tsconfig.json -e \"import('./src/server.ts').then(({ buildServer }) => { if (typeof buildServer !== 'function') throw new Error('Invalid development server entry'); })\"",
    "check": "pnpm check:boundaries && pnpm check:docs && pnpm typecheck && pnpm test",
    "prototype": "tsc -b examples/domain-prototype && node examples/domain-prototype/dist/index.js",
    "check:prototype": "node scripts/check-domain-prototype.mjs",
    "verify:quick": "pnpm check && pnpm check:source-resolution && pnpm build",
    "verify": "pnpm check && node scripts/run-e2e.mjs --release",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "pnpm migrate",
    "xecms": "node packages/cli/dist/bin.js",
    "doctor": "node packages/cli/dist/bin.js doctor",
    "release:pack": "node scripts/pack-release.mjs",
    "release:check-install": "node scripts/check-release-install.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
