{
  "name": "xecms",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:admin",
    "build:packages": "tsc -b",
    "build:admin": "pnpm --filter @xecms/admin-app build",
    "clean": "tsc -b --clean",
    "dev": "node scripts/dev.mjs",
    "start": "node packages/cli/dist/bin.js start",
    "migrate": "node scripts/migrate.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:database": "node scripts/run-postgres-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:admin-apps": "node scripts/run-e2e.mjs --suite admin-apps",
    "benchmark:database": "node scripts/run-database-benchmarks.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs && node scripts/check-package-boundaries.mjs",
    "check:docs": "node scripts/check-document-links.mjs",
    "check:source-resolution": "pnpm --filter @xecms/server exec tsx --tsconfig ../../tsconfig.dev.json ../../scripts/check-dev-source-resolution.ts",
    "check": "pnpm check:boundaries && pnpm check:docs && pnpm typecheck && pnpm test:unit",
    "prototype:run": "node examples/domain-prototype/dist/index.js",
    "prototype": "pnpm build && pnpm prototype:run",
    "check:prototype": "node scripts/check-domain-prototype.mjs",
    "verify:quick": "pnpm check && pnpm check:source-resolution && pnpm build && pnpm check:prototype",
    "verify": "pnpm check && node scripts/run-e2e.mjs --release",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "pnpm migrate",
    "xecms": "node packages/cli/dist/bin.js",
    "doctor": "node packages/cli/dist/bin.js doctor"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
