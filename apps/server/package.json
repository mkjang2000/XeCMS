{
  "name": "@xecms/server",
  "version": "0.5.0",
  "description": "Fastify API server and runtime for XeCMS.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/mkjang2000/XeCMS.git", "directory": "apps/server" },
  "homepage": "https://github.com/mkjang2000/XeCMS#readme",
  "bugs": { "url": "https://github.com/mkjang2000/XeCMS/issues" },
  "engines": { "node": ">=22.22.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.integration.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --clear-screen=false --tsconfig ../../tsconfig.dev.json src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx --tsconfig ../../tsconfig.dev.json src/migrate.ts",
    "db:migrate:built": "node dist/migrate.js",
    "test:integration": "XECMS_RUN_POSTGRES_TESTS=true vitest run --config vitest.config.ts src/server.integration.test.ts src/setup-template.integration.test.ts src/m2.integration.test.ts src/m3-acceptance.integration.test.ts",
    "test:integration:content-core": "XECMS_RUN_POSTGRES_TESTS=true vitest run --config vitest.config.ts src/m2.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@xecms/admin-apps": "workspace:*",
    "@xecms/application": "workspace:*",
    "@xecms/contracts": "workspace:*",
    "@xecms/database": "workspace:*",
    "@xecms/example-plugin": "workspace:*",
    "@xecms/plugin-sdk": "workspace:*",
    "@xecms/schema": "workspace:*",
    "fastify": "^5.11.3"
  },
  "devDependencies": {
    "tsx": "^4.23.11",
    "vitest": "^4.1.10"
  }
}
