{
  "name": "@xecms/server",
  "version": "0.4.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --clear-screen=false --tsconfig ../../tsconfig.dev.json src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx --tsconfig ../../tsconfig.dev.json src/migrate.ts",
    "db:migrate:built": "node dist/migrate.js",
    "test:integration": "XECMS_RUN_POSTGRES_TESTS=true vitest run --config vitest.config.ts src/server.integration.test.ts src/m2.integration.test.ts src/m3-acceptance.integration.test.ts",
    "test:integration:m2": "XECMS_RUN_POSTGRES_TESTS=true vitest run --config vitest.config.ts src/m2.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@xecms/admin-apps": "workspace:*",
    "@xecms/application": "workspace:*",
    "@xecms/contracts": "workspace:*",
    "@xecms/database": "workspace:*",
    "@xecms/plugin-sdk": "workspace:*",
    "@xecms/example-plugin": "workspace:*",
    "@xecms/schema": "workspace:*",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^4.1.10"
  }
}
